# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/

# Editor/OS noise
.DS_Store

# Packaging artifacts
build/
dist/
*.egg-info/

# Coverage
.coverage
htmlcov/

# Datasets (cached, never committed)
data/*
!data/README.md

# LaTeX build artifacts
*.aux
*.log
*.out
*.bbl
*.blg
*.spl
*.toc
paper/*.pdf

# Downloaded reference PDFs (author use; commit only CC-licensed ones deliberately)
paper/references/*.pdf

# Local Semantic Scholar API key (never commit a key)
.s2_key
